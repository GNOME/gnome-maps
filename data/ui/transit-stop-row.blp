using Gtk 4.0;
using Adw 1;

template $Gjs_TransitStopRow: ListBoxRow {
  Grid grid {
    column-spacing: 12;

    Adw.Bin trackSegmentContainer {
      halign: start;
      margin-start: 12;

      layout {
        column: 0;
        row: 0;
      }
    }

    Box {
      orientation: vertical;

      Box {
        orientation: horizontal;
        hexpand: true;

        Label nameLabel {
          hexpand: false;
          halign: start;
          margin-top: 6;
          margin-bottom: 6;
          margin-end: 6;
          ellipsize: end;
          wrap: true;
          lines: 2;
        }

        Label trackLabel {
          visible: false;
          halign: start;
          valign: center;
          hexpand: true;
          margin-end: 6;
          ellipsize: end;

          styles [
            "dimmed",
            "caption",
            "pill",
            "track-badge",
          ]
        }
      }

      Label informationLabel  {
        visible: false;
        halign: start;

        styles [
          "dimmed",
          "caption",
        ]
      }

      layout {
        column: 1;
        row: 0;
      }
    }

    Box {
      orientation: horizontal;
      margin-end: 6;

      Label scheduledTimeLabel {
        visible: false;
        halign: end;
        valign: start;
        margin-top: 6;
        margin-bottom: 6;
        margin-end: 6;
        use-markup: true;

        styles [
          "dimmed",
          "numeric",
        ]
      }

      Label timeLabel {
        halign: end;
        valign: start;
        margin-top: 6;
        margin-bottom: 6;
        margin-end: 6;

        styles [
          "dimmed",
          "numeric",
        ]
      }

      Label timezoneOffsetLabel {
        visible: false;
        halign: end;
        valign: start;
        margin-top: 6;
        margin-bottom: 6;
        margin-end: 6;

        styles [
          "dimmed",
          "numeric",
          "caption",
        ]
      }

      layout {
        column: 2;
        row: 0;
      }
    }
  }

  styles [
    "transit-stop-row",
  ]
}
